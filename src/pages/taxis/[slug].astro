---
/** Página propia de cada servicio de taxi: /taxis/<slug>/. Si el servicio tiene varios vehículos, se muestran todos acá. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Placa from '@/components/ui/Placa.astro';
import PortadaTaxi from '@/components/ui/PortadaTaxi.astro';
import BotonesPedir from '@/components/ui/BotonesPedir.astro';
import ResenaGoogle from '@/components/ui/ResenaGoogle.astro';
import { SITE, INICIO, enInicio } from '@/config/site';
import { TARIFA } from '@/data/tarifa';
import {
  type Servicio,
  SERVICIOS_TAXI,
  vehiculosDe,
  paginaDe,
  numeroDe,
  descripcionDe,
  nombrePaginaDe,
  empresaDe,
  otrosNombresDe,
} from '@/data/taxis';

export function getStaticPaths() {
  return SERVICIOS_TAXI.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }));
}

interface Props {
  servicio: Servicio;
}
const { servicio: s } = Astro.props;
const vehiculos = vehiculosDe(s);
const descripcion = descripcionDe(s);
const path = `/taxis/${s.slug}/`;
const url = new URL(paginaDe(s), `${SITE.url}/`).href;
const numero = vehiculos.map(numeroDe).find(Boolean);
const nombre = nombrePaginaDe(s);
const empresa = empresaDe(s);
const alias = otrosNombresDe(s);
// Título para Google, corto para que no lo corte ni en los resultados ni debajo del inicio:
// el nombre conocido y, si es otro, el de la empresa.
const titulo = nombre !== empresa ? `${nombre} · ${empresa}` : `${nombre} · Taxi en Fray Bentos`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: titulo,
      description: descripcion,
      inLanguage: SITE.lang,
      isPartOf: { '@id': `${SITE.url}/#sitio` },
      breadcrumb: { '@id': `${url}#migas` },
      mainEntity: { '@id': `${url}#servicio` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#migas`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Taxis', item: `${SITE.url}/#taxis` },
        { '@type': 'ListItem', position: 3, name: nombre, item: url },
      ],
    },
    {
      '@type': 'TaxiService',
      '@id': `${url}#servicio`,
      name: empresa,
      ...(alias.length ? { alternateName: alias } : {}),
      url,
      description: descripcion,
      provider: { '@type': 'LocalBusiness', name: empresa, ...(alias.length ? { alternateName: alias } : {}), address: { '@type': 'PostalAddress', addressLocality: 'Fray Bentos', addressRegion: 'Río Negro', addressCountry: 'UY' } },
      areaServed: { '@id': `${SITE.url}/#fray-bentos` },
      isRelatedTo: { '@id': `${SITE.url}/#servicio` },
      ...(numero ? { telephone: `+${numero}` } : {}),
    },
  ],
};
---

<BaseLayout title={titulo} description={descripcion} path={path} schema={schema}>
  <PortadaTaxi slug={s.slug} portada={s.portada} alt={`${nombre} en Fray Bentos`} y={s.portadaY}>
    <nav class="migas mono" aria-label="Estás en">
      <a href={INICIO}>Inicio</a><span aria-hidden="true">/</span><a href={enInicio('taxis')}>Taxis</a><span aria-hidden="true">/</span><span aria-current="page">{nombre}</span>
    </nav>
  </PortadaTaxi>
  <section class="taxi-top">
    <div class="wrap">
      <span class="tag">Taxi en Fray Bentos</span>
      <h1>{nombre}</h1>
      <p class="nota mono">{s.nota.replace(/\n/g, ' · ')}</p>
      <p class="desc">{descripcion}</p>

      {
        vehiculos.length === 0 && (
          <div class="acciones sola"><BotonesPedir taxi={{ id: s.slug, servicio: s, nombre, nota: s.nota, destacado: false, placa: '', vehiculo: [], plazas: '', valijas: '', aBordo: [] }} /></div>
        )
      }
      {vehiculos.length > 0 && <h2 class="mono sub">{vehiculos.length === 1 ? 'El auto' : `Los autos (${vehiculos.length})`}</h2>}
      {vehiculos.length > 0 && (
      <ul class="autos">
        {
          vehiculos.map((t) => (
            <li class="auto">
              <div class="auto-head">
                <span class="modelo">{t.vehiculo.join(' ')}</span>
                <Placa numero={t.placa} />
              </div>
              <dl>
                <div><dt>Plazas</dt><dd>{t.plazas || 'A confirmar'}</dd></div>
                <div><dt>Valijas</dt><dd>{t.valijas}</dd></div>
                <div><dt>A bordo</dt><dd>{t.aBordo.join(' · ')}</dd></div>
              </dl>
              <div class="acciones"><BotonesPedir taxi={t} /></div>
            </li>
          ))
        }
      </ul>
      )}
    </div>
  </section>

  <section class="sec datos">
    <div class="wrap grid">
      <div class="bloque">
        <h2>Cómo pedirlo</h2>
        <ol>
          <li>Tocá <b>Pedir ahora</b> para un viaje inmediato o <b>Reservar</b> para otro día u hora.</li>
          <li>Se abre WhatsApp con el mensaje listo para {nombre}.</li>
          <li>Completá desde dónde salís y a dónde vas, y envialo.</li>
          <li>
            Si te queda más cómodo, mandá un <b>audio</b>: decí dónde estás, a dónde vas y si es para ahora o una reserva.
          </li>
        </ol>
      </div>
      <div class="bloque">
        <h2>Cuánto sale</h2>
        <p>
          Cobra la tarifa oficial de la Intendencia de Río Negro: lo que marca el taxímetro a bordo. Con la calculadora del sitio
          sabés el precio estimado antes de subir.
        </p>
        <a class="btn btn-ink" href={`${INICIO}calculadora-de-tarifas/?desde=${s.slug}`}>Calcular mi viaje</a>
        <p class="fuente mono">{TARIFA.fuente}</p>
      </div>
    </div>
  </section>
  <ResenaGoogle servicio={s} nombre={nombre} />
  <section class="sec-volver">
    <div class="wrap">
      <a class="btn btn-line" href={enInicio('taxis')}>← Ver todos los taxis de Fray Bentos</a>
    </div>
  </section>
</BaseLayout>

<style>
  .taxi-top { background: var(--ink); color: var(--paper); padding-block: clamp(24px, 2.5vw, 32px) clamp(56px, 8vw, 96px); }
  .migas { display: flex; flex-wrap: wrap; gap: 10px; font-size: 11px; color: var(--paper); }
  .migas a { color: var(--paper); }
  .migas a:hover { color: var(--yellow); }
  .migas [aria-current] { color: var(--paper); }
  h1 { font-size: clamp(56px, 10vw, 128px); color: var(--yellow); margin: 18px 0 10px; }
  .nota { color: var(--muted-dark); font-size: 12px; }
  .desc { max-width: 40em; font-size: clamp(17px, 1.6vw, 20px); color: var(--paper); margin: 22px 0 48px; }
  .sub { font-size: 12px; color: var(--muted-dark); margin-bottom: 16px; font-weight: 400; }
  .autos { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 16px; }
  .auto { background: var(--ink-deep); border: 2px solid var(--ink-3); border-radius: 14px; padding: 22px 20px; display: flex; flex-direction: column; gap: 18px; }
  .auto-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .modelo { font: 800 30px/1 var(--f-display); text-transform: uppercase; letter-spacing: 0.04em; }
  dl { display: flex; flex-direction: column; margin: 0; font-family: var(--f-mono); font-size: 14px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px dashed var(--ink-3); }
  dt { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-dark); }
  dd { margin: 0; text-align: right; }
  .acciones { display: flex; gap: 10px; }
  .acciones.sola { max-width: 420px; }
  .acciones :global(.pedir) { flex: 1; min-height: 48px; font-size: 15px; }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 4vw, 48px); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  .bloque { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; font-size: 17px; line-height: 1.55; }
  .bloque h2 { font-size: clamp(32px, 4vw, 44px); }
  .bloque ol, .bloque ul { padding-left: 1.2em; display: flex; flex-direction: column; gap: 8px; margin: 0; }
  .fuente { font-size: 10px; color: var(--text-2); letter-spacing: 0.08em; text-transform: none; }
  .sec-volver { padding-bottom: clamp(56px, 8vw, 96px); }
</style>
