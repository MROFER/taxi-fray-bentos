---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Tarifas from '@/components/sections/Tarifas.astro';
import Flota from '@/components/sections/Flota.astro';
import Paradas from '@/components/sections/Paradas.astro';
import Preguntas from '@/components/sections/Preguntas.astro';
import Choferes from '@/components/sections/Choferes.astro';
import InstalarApp from '@/components/sections/InstalarApp.astro';
import { buildSchema } from '@/lib/schema';
---

<BaseLayout path="/" schema={buildSchema()}>
  <!-- Orden: primero lo que resuelve el viaje (pedir, dónde tomarlo, cuánto sale), después las dudas
       del pasajero y al final lo que es para otro público (choferes) o para quien vuelve (la app). -->
  <Hero />
  <Flota />
  <Paradas />
  <Tarifas />
  <Preguntas />
  <Choferes />
  <InstalarApp />
</BaseLayout>
