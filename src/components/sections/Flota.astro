---
import Placa from '@/components/ui/Placa.astro';
import BotonesPedir from '@/components/ui/BotonesPedir.astro';
import { TAXIS, TAXIS_REALES, SERVICIOS_TAXI, numeroDe, paginaDe, pesoDado } from '@/data/taxis';

// Solo en la copia de prueba (GitHub Pages) o en local; en www.taxifraybentos.com.uy no se muestra.
const mostrarPendientes = import.meta.env.DEV || import.meta.env.PUBLIC_MOSTRAR_PENDIENTES === 'si';
// Las tarjetas de ejemplo no cuentan: sus datos quedan a propósito sin completar.
const reales = TAXIS_REALES;
const pendientes = [
  reales.some((t) => t.placa.includes('_')) && 'placas JTX',
  reales.some((t) => !numeroDe(t)) && 'WhatsApp de cada taxi',
  ...reales.filter((t) => !t.plazas).map((t) => `plazas de ${t.nombre}`),
  'fotos reales',
].filter(Boolean);

// En celular aparece el dado que elige un taxi al azar. Gira por todas las tarjetas pero solo frena en taxis reales.
const conDado = TAXIS.length >= 3 && TAXIS_REALES.length > 0;

const columnas = ['Servicio', 'Placa municipal', 'Vehículo', 'Plazas', 'Valijas', 'A bordo'] as const;
---

<!-- El ancla #taxis va en el título: los enlaces a la sección dejan "Elegí el taxi…" arriba, con las tarjetas a la vista. -->
<section class="sec flota" aria-labelledby="taxis">
  <div class="wrap">
    <header class="sec-head">
      <span class="tag">Taxis · {SERVICIOS_TAXI.length} {SERVICIOS_TAXI.length === 1 ? 'servicio' : 'servicios'}</span>
      <h2 id="taxis">Elegí el taxi que necesitás</h2>
      <p>
        Todos con chofer habilitado y taxímetro a la vista. Cada taxi tiene su propio WhatsApp: pedilo ahora o reservalo
        para más tarde.
      </p>
    </header>

    <div class="board-wrap">
      <table class="board" role="table">
        <caption class="sr-only">Taxis disponibles en Fray Bentos</caption>
        <thead role="rowgroup">
          <tr role="row">
            {columnas.map((c) => <th scope="col" role="columnheader">{c}</th>)}
            <th scope="col" role="columnheader"><span class="sr-only">Pedir o reservar</span></th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            TAXIS.map((t) => (
              <tr role="row" class:list={{ destacado: t.servicio.personalizada }} data-ejemplo={t.servicio.ejemplo ? '' : undefined} data-peso={pesoDado(t.servicio)}>
                <th scope="row" role="rowheader" class="svc">
                  {t.servicio.personalizada && (
                    <span class="sello-destacado mono">
                      <svg width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7L12 17.5 5.8 21.2l1.6-7L2 9.5l7.1-.6z" /></svg>
                      Destacado
                    </span>
                  )}
                  {!t.servicio.personalizada ? (
                    <span class="nombre">{t.nombre}</span>
                  ) : (
                    <a class="nombre" href={paginaDe(t.servicio)}>
                      {t.nombre}
                      <span class="ver mono" aria-hidden="true">Ver página →</span>
                    </a>
                  )}
                  <small>{t.nota}</small>
                </th>
                <td role="cell" data-label="Placa">
                  <Placa numero={t.placa} />
                </td>
                <td role="cell" data-label="Vehículo">
                  <span>{t.vehiculo.map((linea, i) => (i ? [<br />, linea] : linea))}</span>
                </td>
                <td role="cell" data-label="Plazas">
                  <span class="flip">
                    <i class:list={{ todo: !t.plazas }}>{t.plazas || '?'}</i>
                  </span>
                </td>
                <td role="cell" data-label="Valijas">{t.valijas}</td>
                <td role="cell" data-label="A bordo">
                  <span class="pills">
                    {t.aBordo.map((b) => (
                      <span class="pill">{b}</span>
                    ))}
                  </span>
                </td>
                <td role="cell" class="acciones-td">
                  <div class="acciones">
                    <BotonesPedir taxi={t} />
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="carrusel-ctl">
      <div class="puntos" id="taxis-puntos" aria-hidden="true">{TAXIS.map(() => <span />)}</div>
      {
        conDado && (
          <div class="dado-zona">
            <button class="dado" id="taxis-dado" type="button">
              <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="3" width="26" height="26" rx="6" fill="#1b1a17" /><circle cx="10" cy="10" r="2.6" fill="#f2b705" /><circle cx="22" cy="10" r="2.6" fill="#f2b705" /><circle cx="16" cy="16" r="2.6" fill="#f2b705" /><circle cx="10" cy="22" r="2.6" fill="#f2b705" /><circle cx="22" cy="22" r="2.6" fill="#f2b705" /></svg>
              Cualquier taxi
            </button>
            <p class="dado-res mono" id="taxis-dado-res" aria-live="polite"></p>
          </div>
        )
      }
    </div>
    {mostrarPendientes && pendientes.length > 1 && <p class="flota-note">[Pendiente: {pendientes.join(', ')}.]</p>}
  </div>
</section>

<script>
  import { carrusel } from '@/scripts/carrusel-taxis';
  carrusel();
</script>

<style>
  .flota { background: var(--ink); color: var(--paper); }
  .flota .sec-head p { color: var(--muted-dark); }
  #taxis { scroll-margin-top: 20px; }
  .board-wrap { position: relative; overflow-x: auto; border: 2px solid var(--ink-3); border-radius: 14px; background: var(--ink-deep); }
  .board { width: 100%; min-width: 980px; border-collapse: collapse; font-family: var(--f-mono); font-size: 14px; }
  thead th { text-align: left; font-weight: 400; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted-dark); padding: 16px 18px; background: var(--ink-2); }
  td, .svc { padding: 20px 18px; border-top: 1px solid var(--ink-3); vertical-align: middle; text-align: left; }
  tbody tr:hover { background: #17160f; }
  .svc { font: 800 26px/1 var(--f-display); letter-spacing: 0.06em; text-transform: uppercase; color: var(--yellow); }
  a.nombre { color: inherit; text-decoration: none; display: inline-flex; flex-direction: column; gap: 6px; }
  a.nombre:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .ver { font-size: 10px; letter-spacing: 0.16em; color: var(--paper); font-weight: 700; }
  .svc small { display: block; font: 400 11px var(--f-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-dark); margin-top: 6px; white-space: pre; }
  .flip { display: inline-flex; gap: 3px; }
  .flip i {
    font-style: normal; display: inline-grid; place-items: center; width: 24px; height: 30px;
    background: var(--ink-2); border-radius: 3px; color: var(--paper); font-weight: 700; box-shadow: inset 0 -15px 0 rgba(0, 0, 0, 0.25);
  }
  .flip i.todo { color: var(--yellow); }
  .pill { display: inline-block; border: 1px solid var(--ink-3); border-radius: 4px; padding: 3px 8px; margin: 2px 4px 2px 0; font-size: 12px; color: var(--muted-dark); }
  .acciones { display: flex; flex-direction: column; gap: 8px; }
  /* Taxis con página personalizada: etiqueta "Destacado" (en escritorio arriba del nombre; en celular, sobre el borde). */
  .sello-destacado {
    display: flex; align-items: center; gap: 6px; width: max-content; margin-bottom: 10px;
    background: var(--yellow); color: var(--ink); font-size: 10px; font-weight: 700; line-height: 1; letter-spacing: 0.18em;
    text-transform: uppercase; padding: 5px 8px; border-radius: 3px;
  }
  .board tr.clon, .carrusel-ctl { display: none; }
  .carrusel-ctl { flex-direction: column; align-items: center; gap: 22px; }
  .puntos { display: flex; justify-content: center; gap: 8px; }
  .puntos span { width: 9px; height: 9px; border-radius: 5px; background: var(--ink-3); transition: width 0.2s, background 0.2s; }
  .puntos span.activo { width: 24px; background: var(--yellow); }
  .dado-zona { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .dado {
    display: inline-flex; align-items: center; gap: 12px; min-height: 54px; padding: 10px 22px 10px 14px; cursor: pointer;
    background: var(--paper); color: var(--ink); border: 2px solid var(--paper); border-radius: 8px; font: 700 16px var(--f-body);
    box-shadow: 5px 5px 0 var(--yellow);
  }
  .dado:active { transform: translate(2px, 2px); box-shadow: 3px 3px 0 var(--yellow); }
  .dado:disabled { opacity: 0.7; cursor: wait; }
  .dado svg { width: 30px; height: 30px; flex: none; }
  .dado.girando svg { animation: rodar 0.4s linear infinite; }
  .dado-res { min-height: 1.5em; margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; color: var(--yellow); text-align: center; }
  @keyframes rodar { to { transform: rotate(360deg); } }
  @keyframes latido { 50% { transform: scale(1.04); } }
  @media (prefers-reduced-motion: reduce) {
    .board tr, .puntos span { transition: none !important; }
    .board tr.ganadora, .dado.girando svg { animation: none !important; }
  }
  .flota-note { margin-top: 18px; color: var(--muted-dark); font-size: 14px; }

  /* Celular: cada taxi pasa a ser una tarjeta (sin scroll horizontal). Los role explícitos mantienen la semántica de tabla para lectores de pantalla. */
  @media (max-width: 760px) {
    .board-wrap { overflow: visible; border: 0; background: none; border-radius: 0; }
    .board { min-width: 0; display: block; }
    .board caption, .board thead { display: none; }
    /* Carrusel: cada tarjeta mantiene el ancho de siempre; las de los costados asoman detrás, en los márgenes. */
    .board tbody {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
      margin-inline: calc(-1 * var(--gutter)); padding: 22px var(--gutter) 16px;
    }
    .board tbody::-webkit-scrollbar { display: none; }
    .board tr {
      display: grid; grid-template-columns: 1fr auto; gap: 0 12px; align-content: start;
      background: var(--ink-deep); border: 2px solid var(--ink-3); border-radius: 14px; padding: 18px 16px;
      position: relative; z-index: 1; flex: 0 0 calc(100vw - 2 * var(--gutter)); margin-inline: -20px; scroll-snap-align: center;
      transform: scale(0.88); filter: brightness(0.45); transition: transform 0.25s, filter 0.25s, border-color 0.25s;
    }
    .board tr.clon { display: grid; }
    .board tbody.rapido tr { transition-duration: 0.08s; }
    .board tr.activa {
      z-index: 3; transform: none; filter: none; border-color: #57524a;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(0, 0, 0, 0.6);
    }
    .board tr.destacado { border-color: var(--yellow); }
    .board .sello-destacado {
      position: absolute; top: -13px; left: 16px; z-index: 2; margin: 0;
      padding: 6px 10px; border-radius: 4px; border: 2px solid var(--ink-deep);
    }
    .board tr.ganadora { border-color: var(--yellow); animation: latido 0.6s 2; }
    .carrusel-ctl { display: flex; }
    tbody tr:hover { background: var(--ink-deep); }
    /* El nombre queda al lado de la placa y la nota abajo, a todo el ancho. */
    .board .svc { display: contents; font-size: 30px; }
    .svc .nombre { grid-column: 1; grid-row: 1; padding-bottom: 8px; }
    a.nombre { color: inherit; text-decoration: none; display: inline-flex; flex-direction: column; gap: 6px; }
  a.nombre:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .ver { font-size: 10px; letter-spacing: 0.16em; color: var(--paper); font-weight: 700; }
  .svc small { grid-column: 1 / -1; grid-row: 2; margin: 0; padding-bottom: 14px; }
    .board td { display: flex; justify-content: space-between; align-items: center; gap: 12px; grid-column: 1 / -1; padding: 10px 0; border-top: 1px dashed var(--ink-3); }
    .board td[data-label]::before { content: attr(data-label); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-dark); flex: none; }
    .board td[data-label='Placa'] { grid-column: 2; grid-row: 1; border: 0; padding: 0 0 8px; align-items: flex-start; }
    .board td[data-label='Placa']::before { display: none; }
    .board td[data-label='Vehículo'], .board td[data-label='A bordo'] { text-align: right; }
    .pills { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px; }
    .pills .pill { margin: 0; }
    .board .acciones-td { border-top: 0; padding-top: 14px; }
    .acciones { flex-direction: row; width: 100%; }
  }
</style>
