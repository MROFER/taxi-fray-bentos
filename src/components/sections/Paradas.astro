---
import { PARADAS } from '@/data/paradas';
import { sugerirDirecciones, puntoDeCalle } from '@calc/direcciones.js';

// Coordenadas de cada parada, resueltas en el build con las mismas calles que usa la calculadora.
const paradas = PARADAS.map((p) => {
  const s = sugerirDirecciones(p.consulta);
  const punto = s.find((x) => x.tipo === 'esquina')?.punto ?? (s[0]?.tipo === 'calle' ? puntoDeCalle(s[0].indice) : null);
  if (!punto) throw new Error(`No se encontró la parada "${p.lugar}" (consulta: "${p.consulta}") en las calles de OpenStreetMap.`);
  return { ...p, punto: punto as [number, number] };
});
---

<section class="sec paradas" id="paradas" aria-labelledby="paradas-title">
  <div class="wrap">
    <header class="sec-head">
      <span class="tag">Paradas</span>
      <h2 id="paradas-title">Paradas de taxi en la ciudad</h2>
      <p>Tocá una parada y la cargamos como punto de salida en el taxímetro.</p>
    </header>
    <ol class="ruta">
      {
        paradas.map((p) => (
          <li class:list={['stop', { end: p.extremo }]}>
            <button type="button" data-parada={p.lugar} data-punto={p.punto.join(',')}>
              <span class="dot" aria-hidden="true" />
              <span class="label">
                <span class="mono">{p.etiqueta}</span>
                <strong>{p.lugar}</strong>
                <span class="dir">{p.direccion}</span>
                <em>Salir de acá</em>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="river" aria-hidden="true">
    <div class="wrap">
      <span class="mono">Río Uruguay</span><span class="mono puente">→ Puente Libertador Gral. San Martín</span>
    </div>
  </div>
</section>

<script>
  import { $, reduceMotion } from '@/scripts/ui';
  import { cargarTaximetro } from '@/scripts/taximetro/index';

  document.querySelectorAll<HTMLButtonElement>('[data-parada]').forEach((b) => {
    b.addEventListener('pointerenter', () => void cargarTaximetro(), { once: true });
    b.addEventListener('click', async () => {
      const [lat, lon] = (b.dataset.punto ?? '').split(',').map(Number);
      $('pedir').scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' });
      const app = await cargarTaximetro();
      app.salirDesde(b.dataset.parada ?? '', [lat!, lon!]);
      setTimeout(() => $('destino-direccion').focus({ preventScroll: true }), 450);
    });
  });
</script>

<style>
  .paradas { position: relative; padding-bottom: 0; }
  .ruta {
    list-style: none; margin: 0; padding: 0; position: relative;
    display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); min-height: 400px;
  }
  .ruta::before {
    content: ''; position: absolute; left: calc(100% / 14); right: calc(100% / 14); top: 50%;
    height: 22px; transform: translateY(-50%); background: var(--ink); border-radius: 11px;
  }
  .ruta::after {
    content: ''; position: absolute; left: calc(100% / 14 + 14px); right: calc(100% / 14 + 14px); top: 50%;
    border-top: 3px dashed var(--yellow); transform: translateY(-50%);
  }
  .stop { position: relative; display: flex; justify-content: center; }
  .stop button {
    all: unset; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 8px;
    text-align: center; width: 100%; position: absolute; left: 0; top: 0; bottom: 0; box-sizing: border-box;
  }
  .stop button:focus-visible { outline: 3px solid var(--yellow); outline-offset: 3px; border-radius: 8px; }
  .dot {
    position: absolute; top: 50%; left: 50%; width: 34px; height: 34px; transform: translate(-50%, -50%);
    border-radius: 50%; background: var(--paper); border: 6px solid var(--ink); z-index: 2;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .stop.end .dot { background: var(--ink); border-color: var(--yellow); }
  .stop button:hover .dot, .stop button:focus-visible .dot { background: var(--yellow); transform: translate(-50%, -50%) scale(1.15); }
  .label { position: absolute; left: 4px; right: 4px; display: flex; flex-direction: column; gap: 4px; }
  .stop:nth-child(odd) .label { bottom: calc(50% + 32px); }
  .stop:nth-child(even) .label { top: calc(50% + 32px); }
  .label .mono { font-size: 11px; color: var(--muted); }
  .label strong { font: 700 clamp(18px, 1.9vw, 24px)/1 var(--f-display); text-transform: uppercase; text-wrap: balance; }
  .dir { font-size: 13px; line-height: 1.35; color: var(--text-2); }
  .label em {
    font-style: normal; font-size: 12px; color: var(--yellow); background: var(--ink); align-self: center;
    padding: 2px 7px; border-radius: 3px; opacity: 0; transition: opacity 0.15s;
  }
  .stop button:hover em, .stop button:focus-visible em { opacity: 1; }

  .river { margin-top: 40px; background: var(--river); color: var(--paper); padding-block: 22px 26px; position: relative; overflow: hidden; }
  .river::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 10px;
    background: repeating-linear-gradient(90deg, rgba(242, 236, 223, 0.35) 0 50px, transparent 50px 100px);
    animation: drift 14s linear infinite;
  }
  @keyframes drift { to { background-position: 100px 0; } }
  .river .wrap { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .river .mono { letter-spacing: 0.5em; }
  .river .puente { letter-spacing: 0.2em; opacity: 0.7; }

  /* Celular: la línea pasa a vertical y cada parada es una fila tocable. */
  @media (max-width: 820px) {
    .ruta { grid-template-columns: 1fr; min-height: 0; padding-left: 8px; }
    .ruta::before { left: 8px; right: auto; top: 20px; bottom: 20px; width: 18px; height: auto; transform: none; }
    .ruta::after { left: 16px; right: auto; top: 30px; bottom: 30px; border-top: 0; border-left: 3px dashed var(--yellow); transform: none; }
    .stop { min-height: 92px; justify-content: flex-start; }
    .stop button { position: relative; flex-direction: row; align-items: center; gap: 20px; padding-left: 44px; min-height: 92px; }
    .dot { left: 9px; top: 50%; }
    .label, .stop:nth-child(odd) .label, .stop:nth-child(even) .label { position: static; text-align: left; }
    .label em { display: none; }
    .river .mono { letter-spacing: 0.3em; }
  }
</style>
