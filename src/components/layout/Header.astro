---
import Logo from './Logo.astro';
import { NAV } from '@/config/site';
---

<header class="nav">
  <div class="wrap nav-in">
    <Logo />
    <nav class="nav-links" aria-label="Secciones">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <!-- Volver a la calculadora. En móvil va directo al formulario (queda debajo del primer pantallazo);
         en escritorio vuelve al hero, donde la calculadora se ve entera junto al título. -->
    <a class="nav-cta solo-movil" href="#pedir">Calcular</a>
    <a class="nav-cta solo-escritorio" href="#inicio">Calcular viaje</a>
    <button class="nav-menu" type="button" aria-expanded="false" aria-controls="menu-movil" aria-label="Menú">
      <span aria-hidden="true"></span>
    </button>
  </div>
  <nav class="menu-movil" id="menu-movil" aria-label="Secciones" hidden>
    <ul class="wrap">
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</header>
<div class="checker" aria-hidden="true"></div>

<script>
  const boton = document.querySelector<HTMLButtonElement>('.nav-menu')!;
  const menu = document.getElementById('menu-movil')!;
  const escritorio = matchMedia('(min-width: 921px)');

  const abrir = (si: boolean) => {
    boton.setAttribute('aria-expanded', String(si));
    menu.hidden = !si;
  };
  const cerrar = (devolverFoco = false) => {
    if (menu.hidden === true) return;
    abrir(false);
    if (devolverFoco) boton.focus();
  };

  boton.addEventListener('click', () => abrir(menu.hidden === true));
  menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) cerrar(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(true); });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.nav')) cerrar(); });
  escritorio.addEventListener('change', () => cerrar());
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: var(--ink); color: var(--paper);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .nav-in { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: var(--nav-h); }
  .nav-links { display: flex; gap: 28px; align-items: center; margin-left: auto; }
  .nav-links + .nav-cta { margin-left: auto; }
  .solo-escritorio { margin-left: 16px; }
  .nav-links a { text-decoration: none; font-size: 15px; color: var(--muted-dark); padding-block: 8px; }
  .nav-links a:hover { color: var(--paper); }

  .nav-cta {
    font-family: var(--f-mono); font-weight: 700; font-size: 14px; letter-spacing: 0.04em; white-space: nowrap;
    background: var(--yellow); color: var(--ink); text-decoration: none;
    padding: 11px 14px; border-radius: 5px; min-height: 44px; display: inline-flex; align-items: center;
  }

  .nav-menu {
    width: 44px; height: 44px; margin-right: -8px; padding: 0; border: 0; border-radius: 5px;
    background: none; color: var(--paper); cursor: pointer; display: grid; place-items: center;
  }
  .nav-menu span, .nav-menu span::before, .nav-menu span::after {
    display: block; width: 22px; height: 2px; background: currentColor; border-radius: 1px;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .nav-menu span { position: relative; }
  .nav-menu span::before, .nav-menu span::after { content: ''; position: absolute; left: 0; }
  .nav-menu span::before { top: -7px; }
  .nav-menu span::after { top: 7px; }
  .nav-menu[aria-expanded='true'] span { background: transparent; }
  .nav-menu[aria-expanded='true'] span::before { transform: translateY(7px) rotate(45deg); }
  .nav-menu[aria-expanded='true'] span::after { transform: translateY(-7px) rotate(-45deg); }

  .menu-movil {
    position: absolute; inset-inline: 0; top: 100%;
    background: var(--ink); border-top: 1px solid var(--ink-3);
    box-shadow: 0 16px 32px rgb(0 0 0 / 0.35);
    max-height: calc(100dvh - var(--nav-h)); overflow-y: auto;
  }
  .menu-movil ul { list-style: none; margin: 0; padding-block: 8px 16px; }
  .menu-movil li + li { border-top: 1px solid var(--ink-3); }
  .menu-movil a {
    display: flex; align-items: center; min-height: 56px;
    font-family: var(--f-display); font-weight: 800; font-size: 26px; text-transform: uppercase; letter-spacing: 0.01em;
    color: var(--paper); text-decoration: none;
  }
  .menu-movil a:active { color: var(--yellow); }

  /* Escritorio: links a la vista y el botón vuelve al hero. Móvil: botón corto y hamburguesa. */
  @media (min-width: 921px) {
    .solo-movil, .nav-menu, .menu-movil { display: none; }
  }
  @media (max-width: 920px) { .nav-links, .solo-escritorio { display: none; } }
  @media (max-width: 360px) { .nav-cta { font-size: 13px; padding-inline: 10px; } }
</style>
