<div class="toast" id="toast" role="status" aria-live="polite"></div>

<style>
  .toast {
    position: fixed; left: 50%; bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    transform: translate(-50%, 20px); width: max-content; max-width: min(92vw, 520px);
    background: var(--ink); color: var(--paper); border: 2px solid var(--yellow); border-radius: 8px;
    padding: 12px 16px; font-size: 14px; opacity: 0; pointer-events: none;
    transition: opacity 0.2s, transform 0.2s; z-index: 50;
  }
  .toast:global(.on) { opacity: 1; transform: translate(-50%, 0); }
</style>
