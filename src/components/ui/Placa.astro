---
interface Props {
  numero: string;
}
const { numero } = Astro.props;
const pendiente = numero.includes('_');
---

<span class="placa" title={pendiente ? 'Placa a confirmar' : undefined}>
  <small>RÍO NEGRO</small><b>{numero}</b>
</span>

<style>
  .placa {
    display: inline-flex; flex-direction: column; align-items: center;
    background: var(--receipt); color: var(--ink); border: 2px solid var(--ink-3); border-radius: 5px;
    padding: 3px 10px 4px; box-shadow: inset 0 0 0 2px var(--receipt), inset 0 0 0 3px var(--ink);
  }
  small { font: 700 8px/1.3 var(--f-mono); letter-spacing: 0.2em; color: var(--river); }
  b { font: 700 17px/1.1 var(--f-mono); letter-spacing: 0.08em; white-space: nowrap; }
</style>
