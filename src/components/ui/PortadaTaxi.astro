---
/**
 * Portada de la página de un taxi, a todo el ancho y pegada a la barra de navegación, con las migas encima.
 * La foto sale de src/assets/taxis/<slug>.(jpg|jpeg|png|webp). Sin foto, en el dominio no se muestra la portada
 * (las migas quedan solas arriba); en la copia de prueba se ve el lugar marcado como pendiente.
 */
import { Image } from 'astro:assets';

interface Props {
  slug: string;
  alt: string;
  /** Encuadre vertical de la foto, de 0 (arriba) a 100 (abajo). */
  y?: number;
}
const { slug, alt, y = 50 } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/taxis/*.{jpg,jpeg,png,webp}', { eager: true });
const foto = Object.entries(fotos).find(([ruta]) => ruta.replace(/^.*\/|\.[a-z]+$/g, '') === slug)?.[1].default;
const mostrarPendientes = import.meta.env.DEV || import.meta.env.PUBLIC_MOSTRAR_PENDIENTES === 'si';
const conPortada = Boolean(foto) || mostrarPendientes;
---

<div class:list={['cover', { 'sin-foto': !conPortada }]}>
  {
    foto ? (
      <Image class="cover-img" style={`object-position: 50% ${y}%`} src={foto} alt={alt} widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" />
    ) : (
      conPortada && (
        <div class="cover-img vacia">
          <span class="mono">[Pendiente: foto de portada · 1920 × 720]</span>
        </div>
      )
    )
  }
  <div class="wrap cover-migas">
    <slot />
  </div>
</div>

<style>
  .cover { position: relative; height: clamp(240px, min(36vw, 50vh), 480px); background: var(--ink-2); overflow: hidden; }
  .cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .vacia { display: grid; place-items: center; background: repeating-linear-gradient(135deg, #2a2822 0 22px, #312e27 22px 44px); }
  .vacia span { color: var(--muted-dark); font-size: 13px; background: rgba(15, 14, 11, 0.7); padding: 10px 16px; border-radius: 6px; }
  /* Sombra arriba para que las migas se lean sobre cualquier foto. */
  .cover::before { content: ''; position: absolute; inset: 0 0 auto; height: 110px; z-index: 1; background: linear-gradient(rgba(15, 14, 11, 0.75), transparent); }
  .cover-migas { position: relative; z-index: 2; padding-top: 22px; }
  .cover.sin-foto { height: auto; background: var(--ink); }
  .cover.sin-foto::before { display: none; }
</style>
