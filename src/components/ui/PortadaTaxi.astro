---
/**
 * Portada de la página de un taxi: la foto de src/assets/taxis/<slug>.(jpg|jpeg|png|webp) si existe;
 * si no hay foto, no se muestra nada (en la copia de prueba queda marcado el lugar).
 */
import { Image } from 'astro:assets';

interface Props {
  slug: string;
  alt: string;
}
const { slug, alt } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/taxis/*.{jpg,jpeg,png,webp}', { eager: true });
const foto = Object.entries(fotos).find(([ruta]) => ruta.replace(/^.*\/|\.[a-z]+$/g, '') === slug)?.[1].default;
// Solo en la copia de prueba (GitHub Pages) o en local: marca dónde va la foto mientras no esté.
const mostrarPendientes = import.meta.env.DEV || import.meta.env.PUBLIC_MOSTRAR_PENDIENTES === 'si';
---

{
  foto ? (
    <div class="portada">
      <Image src={foto} alt={alt} widths={[640, 1024, 1600, 2200]} sizes="(max-width: 1240px) 100vw, 1200px" loading="eager" fetchpriority="high" />
    </div>
  ) : (
    mostrarPendientes && <div class="portada vacia mono">[Pendiente: foto de portada]</div>
  )
}

<style>
  .portada { aspect-ratio: 12 / 5; border-radius: 16px; overflow: hidden; border: 2px solid var(--ink-3); margin-bottom: 32px; }
  .portada :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vacia { display: grid; place-items: center; border-style: dashed; color: var(--muted-dark); font-size: 12px; }
  @media (max-width: 640px) { .portada { aspect-ratio: 4 / 3; } }
</style>
