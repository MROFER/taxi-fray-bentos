---
/**
 * Recuadro de reseñas de Google en la página de un taxi: el QR que abre "Escribir una reseña" de su Perfil de Empresa,
 * un botón para abrirlo desde el mismo celular y otro para compartir el enlace.
 * El QR se genera en el build con el mismo enlace que da Google, así se ve nítido a cualquier tamaño.
 */
import QRCode from 'qrcode';
import type { Servicio } from '@/data/taxis';

interface Props {
  servicio: Servicio;
  nombre: string;
}
const { servicio, nombre } = Astro.props;
// Sin enlace el recuadro igual se muestra, con el QR borroso y el aviso de que está en camino.
const pendiente = !servicio.resenaGoogle;
const enlace = servicio.resenaGoogle || 'https://g.page/r/EJEMPLO/review';
const qr = await QRCode.toString(enlace, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1b1a17', light: '#00000000' } });
---

<section class="resena" aria-labelledby="resena-title">
      <div class="wrap">
        <div class="tarjeta">
          {
            pendiente ? (
              <div class="qr pendiente" role="img" aria-label="El código QR de reseñas todavía no está disponible">
                <Fragment set:html={qr} />
                <span class="aviso mono">
                  <span class="puntos" aria-hidden="true"><i /><i /><i /></span>
                  QR en camino
                </span>
              </div>
            ) : (
              <div class="qr" role="img" aria-label={`Código QR para dejarle una reseña a ${nombre} en Google`}>
                <Fragment set:html={qr} />
              </div>
            )
          }
          <div class="texto">
            <span class="tag dark">Reseñas</span>
            <h2 id="resena-title">¿Viajaste con {nombre}?</h2>
            {
              pendiente ? (
                <p>
                  Muy pronto vas a poder dejarle tu reseña en Google desde acá: escaneando el código con la cámara del
                  celular o tocando el botón. Estamos terminando de prepararlo.
                </p>
              ) : (
                <p>
                  Contale a otros cómo te fue. Escaneá el código con la cámara del celular, o tocá el botón, y dejale tu
                  reseña en Google. Te lleva un minuto y lo ayuda un montón.
                </p>
              )
            }
            {pendiente ? (
              <div class="ctas">
                <span class="btn btn-ink apagado" aria-disabled="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z" /></svg>
                  Reseñas próximamente
                </span>
              </div>
            ) : (
            <div class="ctas">
              <a class="btn btn-ink" href={enlace} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z" /></svg>
                Dejar reseña
              </a>
              <button type="button" class="btn btn-line" data-compartir-resena={enlace} data-nombre={nombre}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="19" r="2.5" /><path d="m8.2 10.8 7.6-4.4M8.2 13.2l7.6 4.4" /></g></svg>
                Compartir
              </button>
            </div>
            )}
          </div>
        </div>
      </div>
    </section>

<script>
  import { toast } from '@/scripts/ui';

  document.querySelectorAll<HTMLButtonElement>('[data-compartir-resena]').forEach((b) =>
    b.addEventListener('click', async () => {
      const url = b.dataset.compartirResena!;
      const texto = `Dejale tu reseña a ${b.dataset.nombre} en Google`;
      if (navigator.share) {
        try {
          await navigator.share({ title: texto, text: `${texto}:`, url });
        } catch {
          /* La persona cerró el menú de compartir. */
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        toast('Enlace copiado. Pegalo donde quieras compartirlo.');
      } catch {
        window.prompt('Copiá el enlace:', url);
      }
    }),
  );
</script>

<style>
  .resena { padding-block: 0 clamp(48px, 7vw, 88px); }
  .tarjeta {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: center;
    background: var(--yellow); border: 3px solid var(--ink); border-radius: 18px; padding: clamp(20px, 3.5vw, 36px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .qr {
    position: relative; width: clamp(150px, 18vw, 200px); aspect-ratio: 1; padding: 14px;
    background: var(--paper); border: 3px solid var(--ink); border-radius: 12px;
  }
  .qr :global(svg) { display: block; width: 100%; height: 100%; }
  .pendiente :global(svg) { filter: blur(5px); opacity: 0.35; }
  .aviso {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); text-align: center;
  }
  .puntos { display: flex; gap: 6px; }
  .puntos i { width: 9px; height: 9px; border-radius: 50%; background: var(--ink); animation: salto 1.2s ease-in-out infinite; }
  .puntos i:nth-child(2) { animation-delay: 0.15s; }
  .puntos i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes salto { 0%, 60%, 100% { transform: translateY(0); opacity: 0.35; } 30% { transform: translateY(-6px); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .puntos i { animation: none; opacity: 0.6; } }
  .apagado { opacity: 0.55; cursor: default; pointer-events: none; }
  .texto { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; color: var(--ink); }
  h2 { font-size: clamp(30px, 4vw, 44px); }
  p { font-size: 17px; line-height: 1.55; max-width: 34em; margin: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .ctas .btn { gap: 8px; }
  .ctas .btn-line { background: var(--paper); }
  @media (max-width: 620px) {
    .tarjeta { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .texto { align-items: center; }
    .texto :global(.tag) { align-self: center; }
    .ctas { justify-content: center; width: 100%; }
    .ctas .btn { flex: 1 1 100%; }
  }
</style>
