---
/**
 * Redes sociales de un taxi en su página: ícono amarillo y el usuario (ej. "@taxilechuzas"), como el Instagram del pie.
 * Se cargan en el panel, dentro de "Página propia". Sin redes no se muestra nada.
 */
import { type Red, usuarioDe } from '@/data/taxis';

interface Props {
  redes: Red[];
  nombre: string;
}
const { redes, nombre } = Astro.props;
const NOMBRE_RED = { instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', youtube: 'YouTube', web: 'Sitio web' };
---

{
  redes.length > 0 && (
    <ul class="redes" aria-label={`Redes de ${nombre}`}>
      {redes.map((r) => (
        <li>
          <a class="red" href={r.enlace} target="_blank" rel="noopener" aria-label={`${NOMBRE_RED[r.red]} de ${nombre}: ${usuarioDe(r)}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              {r.red === 'instagram' && (
                <Fragment>
                  <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" />
                </Fragment>
              )}
              {r.red === 'facebook' && (
                <path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21h3Z" />
              )}
              {r.red === 'tiktok' && (
                <path fill="currentColor" d="M16.6 3c.3 2.3 1.6 3.8 3.9 4v2.7c-1.4.1-2.7-.3-3.9-1v5.8c0 3.5-2.6 5.5-5.4 5.5A5.4 5.4 0 0 1 5.8 14.6c0-3.3 2.9-5.6 6.1-5.1v2.9c-1.5-.4-3.2.6-3.2 2.2 0 1.4 1.1 2.5 2.5 2.5 1.6 0 2.5-1.1 2.5-2.8V3h2.9Z" />
              )}
              {r.red === 'youtube' && (
                <Fragment>
                  <rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="2" />
                  <path fill="currentColor" d="m10 9 5 3-5 3V9Z" />
                </Fragment>
              )}
              {r.red === 'web' && (
                <Fragment>
                  <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                  <path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3Z" fill="none" stroke="currentColor" stroke-width="2" />
                </Fragment>
              )}
            </svg>
            <span>{usuarioDe(r)}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .redes { list-style: none; padding: 0; margin: -28px 0 40px; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .red { display: inline-flex; align-items: center; gap: 8px; color: var(--paper); text-decoration: none; font-size: 15px; min-height: 32px; }
  .red svg { color: var(--yellow); flex: none; }
  .red:hover span { text-decoration: underline; text-underline-offset: 3px; }
</style>
